{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal, modern PostgreSQL studio",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "build:electron": "node electron/build.mjs",
    "app": "pnpm build && pnpm build:electron && electron .",
    "package": "./scripts/package.sh",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "^3.14.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.21",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.10.0",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "dev.slate.studio",
    "productName": "Slate",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0"
    },
    "npmRebuild": false
  }
}
